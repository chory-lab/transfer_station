# ---------------------------------------------------------------------------
# Deployment manifest.
#
# This is the whole per-project interface. A second instrument (syringe_pump)
# needs its own copy of this file and nothing else -- build.sh, cscript.sh and
# the templates are shared verbatim.
# ---------------------------------------------------------------------------

# --- identity -------------------------------------------------------------
APP_NAME=transfer-station
PI_HOSTNAME=transfer-station
PI_USER=chorylab

# Password for PI_USER. Override at build time:  PI_PASSWORD=... ./build.sh
# Never commit a real one -- this repository is public.
PI_PASSWORD=changeme

# Optional SSH public key. Preferred over a password; a public key in a public
# repo is harmless by design.
PI_SSH_PUBKEY=

# --- where the app lives --------------------------------------------------
# NOTE: api_step_motor.py hardcodes /home/chorylab/transfer_station/templates,
# so this path and PI_USER are load-bearing for this project specifically.
REPO_DEST=/home/chorylab/transfer_station

# --- what to install ------------------------------------------------------
# apt packages. Pure-Python dependencies belong in pyproject.toml/uv.lock;
# only C extensions and services need to come from apt.
APT_PACKAGES=redis-server,python3-rpi.gpio

# --- what to run ----------------------------------------------------------
# ${VENV} expands to REPO_DEST/.venv
# Single-quoted: the placeholders are substituted by build.sh, not by the
# shell that sources this file.
APP_EXEC='${VENV}/bin/flask --app api_step_motor run --host=0.0.0.0 --port=${SERVER_PORT}'
SERVICE_REQUIRES=redis-server.service

# --- isolated ethernet ----------------------------------------------------
# Static, with no gateway and no DNS: without a default route on this
# interface the Pi cannot reach, or be reached from, the lab LAN. Only hosts
# on the same physical switch can see it.
ETH_IFACE=eth0
ETH_ADDRESS=192.168.10.1
ETH_PREFIX=24
SERVER_PORT=5000

# --- misc -----------------------------------------------------------------
TIMEZONE=America/Los_Angeles
GROW_MB=2048

# --- pinned inputs --------------------------------------------------------
# Every external input to the build is pinned. An image is only debuggable if
# rebuilding it a month later produces the same thing: with floating inputs,
# "it worked in August and not in October" has no bisectable cause. Moving any
# of these is a deliberate, reviewable commit.
#
# Raspberry Pi OS Lite 64-bit, by dated URL rather than raspios_lite_arm64_latest.
# The checksum is the one published beside the image; build.sh refuses a
# mismatch rather than customising something it did not expect.
IMAGE_URL=https://downloads.raspberrypi.com/raspios_lite_arm64/images/raspios_lite_arm64-2026-06-19/2026-06-18-raspios-trixie-arm64-lite.img.xz
IMAGE_SHA256=acff736ca7945e3b305f07cda4abdb870910e12634991da69783611756e381b3

# sdm, by release tag. The installer itself is fetched by commit, not from
# master -- otherwise the pin only covers half the supply chain. build.sh
# checks the version it actually got. An unannounced change here renamed the
# user plugin's argument from username= to adduser= and broke the build.
SDM_VERSION=V15.8
SDM_COMMIT=5a63de1e8f118772483e931c1ad8ac49bf104dd9

# uv, by version. The installer honours a version in its URL.
UV_VERSION=0.12.5
