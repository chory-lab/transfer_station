# Regenerate after editing:
#   uv pip compile requirements.in -o requirements.txt --generate-hashes \
#       --python-version 3.13 --python-platform aarch64-manylinux2014
#
# RPi.GPIO is deliberately absent: it is a C extension and comes from the apt
# package python3-rpi.gpio, made visible to the venv via --system-site-packages.
