# ---------------------------------------------------------------------------
# Transfer Station image configuration.
# Sourced by flash.sh / flash.ps1 and copied onto the SD card's boot partition.
# Plain `KEY=value` only -- this file is parsed by both bash and PowerShell.
# ---------------------------------------------------------------------------

# Login account created on first boot.
PI_USER=chorylab
# WARNING: this repository is PUBLIC. Do not commit a real password here --
# it would be published permanently in git history, and this is the device's
# SSH login. Change it on the card you flash, or use PI_SSH_PUBKEY below.
PI_PASSWORD=changeme
PI_HOSTNAME=transfer-station

# Optional: contents of an SSH public key to authorise for PI_USER.
# Leave empty to rely on password login only.
PI_SSH_PUBKEY=

# Isolated ethernet link. No gateway and no DNS are configured on this
# interface, so it can never carry traffic to or from the lab LAN -- it is
# reachable only by a host plugged into the same switch.
ETH_IFACE=eth0
ETH_ADDRESS=192.168.10.1
ETH_PREFIX=24

# Flask server bind port. UI ends up at http://ETH_ADDRESS:SERVER_PORT
SERVER_PORT=5000

# Where the repository is installed on the Pi.
REPO_DEST=/home/chorylab/transfer_station

# System timezone (see `timedatectl list-timezones`).
TIMEZONE=America/Los_Angeles

# Shared with the sdm image pipeline. A versioned installer/bundle makes the
# recovery provisioning path reproducible too.
UV_VERSION=0.12.5
